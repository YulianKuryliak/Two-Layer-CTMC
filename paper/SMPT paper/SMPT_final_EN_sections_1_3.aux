\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textcolor {black}{Information used by the two models. The ``target rule'' in \textup  {\textsc  {TwoScale}}{} is uniform among susceptible nodes in all experiments in this article.}}}{5}{table.1}\protected@file@percent }
