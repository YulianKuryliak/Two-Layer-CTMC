\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Clique--bridge--leaf benchmark: $n=100$, $k=2$, $\beta =0.005$, and 10,000 paired runs. Densities show first bridge infection, the signed difference $T_{\mathrm  {export}}-T_B$, and first export. A negative middle-panel value is possible only for MicroMacro and records export before any true bridge infection.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:clique_leaf_density_panels}{{1}{6}{Clique--bridge--leaf benchmark: $n=100$, $k=2$, $\beta =0.005$, and 10,000 paired runs. Densities show first bridge infection, the signed difference $T_{\mathrm {export}}-T_B$, and first export. A negative middle-panel value is possible only for MicroMacro and records export before any true bridge infection}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Single-source export with a random initial infected node: $n=1000$, $\beta _{\mathrm  {in}}=\beta _{\mathrm  {out}}=0.003$, and $k=1$ (top) or $k=5$ (bottom). Left: mean first-export times for Full Micro and Production MicroMacro. Centre: empirical Wasserstein distance normalized by the mean Full export time. Right: percentage of MicroMacro replications exporting before the first true bridge infection; Full Micro had no such events. Whiskers in the left and right columns are pointwise $95\%$ percentile-bootstrap intervals over graph blocks. Zero observed bypasses are displayed as points without a degenerate interval and do not establish zero population probability. Each point uses 400 paired replications. The horizontal coordinate is target ASPL; internal density changes along this tree-augmented graph family.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:aspl_export_fidelity}{{2}{7}{Single-source export with a random initial infected node: $n=1000$, $\beta _{\mathrm {in}}=\beta _{\mathrm {out}}=0.003$, and $k=1$ (top) or $k=5$ (bottom). Left: mean first-export times for Full Micro and Production MicroMacro. Centre: empirical Wasserstein distance normalized by the mean Full export time. Right: percentage of MicroMacro replications exporting before the first true bridge infection; Full Micro had no such events. Whiskers in the left and right columns are pointwise $95\%$ percentile-bootstrap intervals over graph blocks. Zero observed bypasses are displayed as points without a degenerate interval and do not establish zero population probability. Each point uses 400 paired replications. The horizontal coordinate is target ASPL; internal density changes along this tree-augmented graph family}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Internal structure and first-export accuracy}{7}{subsection.6.2}\protected@file@percent }
\newlabel{sec:random_source_export}{{6.2}{7}{Internal structure and first-export accuracy}{subsection.6.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Propagation through a chain of ten $1000$-node cliques with one inter-community edge per adjacent pair ($k=1$). Left: pointwise median number of infected nodes across 400 replications, with interquartile bands. Right: empirical CDF of the first infection time $T_9$ in the tenth community. The displayed time axis ends at $6000$; four Full Micro and two MicroMacro arrivals lie to its right, but all were observed before $T_{\max }=30000$.}}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:chain_cliques_propagation_cdf}{{3}{8}{Propagation through a chain of ten $1000$-node cliques with one inter-community edge per adjacent pair ($k=1$). Left: pointwise median number of infected nodes across 400 replications, with interquartile bands. Right: empirical CDF of the first infection time $T_9$ in the tenth community. The displayed time axis ends at $6000$; four Full Micro and two MicroMacro arrivals lie to its right, but all were observed before $T_{\max }=30000$}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Repeated crossings through a chain of cliques}{8}{subsection.6.3}\protected@file@percent }
\newlabel{sec:chain_cliques_propagation}{{6.3}{8}{Repeated crossings through a chain of cliques}{subsection.6.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Cumulative arrival differences in random-community chains}{8}{subsection.6.4}\protected@file@percent }
\newlabel{sec:chain_random_aspl}{{6.4}{8}{Cumulative arrival differences in random-community chains}{subsection.6.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Arrival-time accuracy in ten-community chains. ASPL $1$ is the clique control; ASPL $2$--$6$ denote connected random graphs. Rows distinguish interface widths $k=1$ and $k=5$; columns give cumulative first-arrival times at communities $1$--$9$, measured from the start of the run. Left: percentage difference between MicroMacro and Full medians, relative to the Full median (negative means earlier MicroMacro arrival). Right: empirical Wasserstein-1 distance relative to the mean Full arrival time. Cell numbers are percentages; each uses 400 pairs with observed arrivals. No uncertainty intervals are shown.}}{9}{figure.caption.8}\protected@file@percent }
\newlabel{fig:chain_aspl_median_map}{{4}{9}{Arrival-time accuracy in ten-community chains. ASPL $1$ is the clique control; ASPL $2$--$6$ denote connected random graphs. Rows distinguish interface widths $k=1$ and $k=5$; columns give cumulative first-arrival times at communities $1$--$9$, measured from the start of the run. Left: percentage difference between MicroMacro and Full medians, relative to the Full median (negative means earlier MicroMacro arrival). Right: empirical Wasserstein-1 distance relative to the mean Full arrival time. Cell numbers are percentages; each uses 400 pairs with observed arrivals. No uncertainty intervals are shown}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Terminal-arrival error across community size and internal graph structure in ten-community chains. Rows show interface widths $k=1$ and $k=5$; columns show the signed shift of the median $T_9$ (MicroMacro minus Full, divided by the Full median) and empirical $W_1$ divided by the mean Full $T_9$. Cell labels are percentages; negative shifts indicate earlier MicroMacro arrival. ASPL $1$ is the clique control. Each cell uses 400 observed paired arrivals. Colour scales are shared between the two $k$ rows for each metric.}}{10}{figure.caption.9}\protected@file@percent }
\newlabel{fig:chain_aspl_size_terminal}{{5}{10}{Terminal-arrival error across community size and internal graph structure in ten-community chains. Rows show interface widths $k=1$ and $k=5$; columns show the signed shift of the median $T_9$ (MicroMacro minus Full, divided by the Full median) and empirical $W_1$ divided by the mean Full $T_9$. Cell labels are percentages; negative shifts indicate earlier MicroMacro arrival. ASPL $1$ is the clique control. Each cell uses 400 observed paired arrivals. Colour scales are shared between the two $k$ rows for each metric}{figure.caption.9}{}}
