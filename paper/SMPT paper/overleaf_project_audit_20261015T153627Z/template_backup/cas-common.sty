\draw[decorate,decoration={brace,amplitude=5pt,mirror},thick] ($(C0.south west)+(0,-1.0)$) -- ($(C4.south east)+(0,-1.0)$) node[midway,below=0.3cm]{$T_{L-1}=\sum_{\ell=0}^{L-2}\Delta_\ell$};
\end{tikzpicture}
\caption{Chain-of-cliques benchmark. Each interface repeats the same information bottleneck. Local first-arrival discrepancies may accumulate into terminal-arrival discrepancies.}
\label{fig:chain_diagram}
\end{figure}

Let $T_\ell$ be the first time at which community $\ell$ becomes infected, with $T_0=0$, and define the local transition delay
\begin{equation}
  \Delta_\ell=T_{\ell+1}-T_\ell,
  \qquad \ell=0,\ldots,L-2.
\end{equation}
The terminal arrival time is
\begin{equation}
  T_{L-1}=\sum_{\ell=0}^{L-2}\Delta_\ell.
  \label{eq:terminal_sum}
\end{equation}
In the full model, each $\Delta_\ell$ is controlled by the time needed for infection to reach the export-relevant interface structure and then to cross an active edge. In the two-scale incomplete-information model, the corresponding predicted delay is controlled by the macro hazard derived from retained community summaries.

\begin{proposition}[Accumulation bound for first-arrival predictions]
\label{prop:w1_bound}
Let $T_{L-1}^{\Full}$ and $T_{L-1}^{\Macro}$ be terminal arrival times in a full-information model and an incomplete-information two-scale model. For any coupling of their local delays,
\begin{equation}
  \Wone\bigl(T_{L-1}^{\Full},T_{L-1}^{\Macro}\bigr)
  \leq
  \Eop\left[\left|\sum_{\ell=0}^{L-2}
  (\Delta_\ell^{\Full}-\Delta_\ell^{\Macro})\right|\right]
  \leq
  \sum_{\ell=0}^{L-2}\Eop\left[|\Delta_\ell^{\Full}-\Delta_\ell^{\Macro}|\right].
  \label{eq:w1_bound}
\end{equation}
If the local delays are modeled as independent across interfaces and optimally coupled pairwise, then
\begin{equation}
  \Wone\bigl(T_{L-1}^{\Full},T_{L-1}^{\Macro}\bigr)
  \leq
  \sum_{\ell=0}^{L-2}\Wone\bigl(\Delta_\ell^{\Full},\Delta_\ell^{\Macro}\bigr).
\end{equation}
\end{proposition}

\begin{proof}
The first inequality follows from the definition of $\Wone$ as the infimum of $\Eop|X-Y|$ over couplings and by evaluating it under the chosen coupling. Equation~\eqref{eq:terminal_sum} gives the difference as a sum of local delay differences. The second inequality is the triangle inequality. Under independent interface-delay approximations, taking the product of optimal pairwise couplings gives the final bound.
\end{proof}

