\subsection{Conditional exactness of the micro layer}

\begin{proposition}[Conditional local exactness]
\label{prop:local_exactness}
Fix the initial microstate in each community. Also fix the complete import process into every community, including all import times and target nodes. Conditional on this import process, the two-scale model evolves each restricted process $X_i(t)=X(t)|_{V_i}$ as the exact CTMC on $G_i=(V_i,E_{ii})$, with the specified imports applied as exogenous $S\to I$ jumps. Consequently, prediction discrepancy relative to the full-network CTMC is generated by the law of the import process, not by the local CTMC dynamics between imports.
\end{proposition}

\begin{proof}
Between two imports, the local channels and propensities coincide with the restriction of the full CTMC to $V_i$. At an import time, the prescribed target node is changed by the specified exogenous jump. Hence, once the import sequence is fixed, the local sample-path law is the law of the corresponding locally forced CTMC. The remaining discrepancy is the difference between the full-network import law and the import law predicted from incomplete information.
\end{proof}

\subsection{Best prediction under an information set}

Under squared-error loss, the best $\calI_t$-measurable predictor of $Y_{ij}(t)$ is the conditional expectation
\begin{equation}
  \widehat a^{\calI}_{ij}(t)=\Eop\bigl[Y_{ij}(t)\mid \calI_t\bigr].
  \label{eq:conditional_intensity_predictor}
\end{equation}
A prevalence-only hazard such as Eq.~\eqref{eq:prevalence_macro_hazard} should therefore be understood as a modelling approximation to this conditional predictor. It is exact under the chosen information only when it equals Eq.~\eqref{eq:conditional_intensity_predictor}.

\begin{proposition}[Value of interface information]
\label{prop:value_info}
Let $\calG_t\subseteq\calH_t\subseteq\calF_t$ be two information sets, and let $Y=Y_{ij}(t)$ be square-integrable. Then
\begin{align}
&\Eop\bigl[(Y-\Eop[Y\mid\calG_t])^2\bigr]
-\Eop\bigl[(Y-\Eop[Y\mid\calH_t])^2\bigr] \notag\\
&\hspace{2cm}=\Eop\bigl[(\Eop[Y\mid\calH_t]-\Eop[Y\mid\calG_t])^2\bigr]\geq0.
\label{eq:value_of_information}
\end{align}
Thus, enriching the interface from $\calG_t$ to $\calH_t$ cannot increase mean-squared prediction error for the instantaneous inter-community intensity. The improvement is the variance explained by the additional information.
\end{proposition}

\begin{proof}
This is the Pythagorean identity for conditional expectations in $L^2$. Conditional expectation is the orthogonal projection of $Y$ onto the subspace of square-integrable random variables measurable with respect to the corresponding sigma-field. Since the subspace for $\calG_t$ is contained in the subspace for $\calH_t$, the projection error cannot increase, and the difference of squared errors is the squared norm of the difference between the two projections.
\end{proof}

\begin{remark}
The result is an information theorem, not a runtime theorem. If $\calG_t$ contains only community prevalence and $\calH_t$ additionally contains active interface exposure, Eq.~\eqref{eq:value_of_information} quantifies how much uncertainty about the next inter-community intensity is removed by communicating the additional summary.
\end{remark}

\subsection{Non-identifiability of prevalence-only hazards}

\begin{proposition}[Non-identifiability from community counts]
\label{prop:nonidentifiability}
Suppose a macro hazard $\lambda_{ij}(x)$ depends only on $\bar i_i(x)$, $\bar s_j(x)$, and $W_{ij}$. If there exist microscopic states $x$ and $y$ such that
\begin{equation}
  \bar i_i(x)=\bar i_i(y),\qquad \bar s_j(x)=\bar s_j(y),
\end{equation}
with the same $W_{ij}$ but
\begin{equation}
  a^\star_{ij}(x)\neq a^\star_{ij}(y),
\end{equation}
then no prevalence-only macro hazard can be exact for both states.
\end{proposition}

\begin{proof}
The macro hazard assigns the same value to $x$ and $y$ because its retained arguments are identical. The full-information intensities differ. Therefore the same macro value cannot equal both exact intensities.
\end{proof}

