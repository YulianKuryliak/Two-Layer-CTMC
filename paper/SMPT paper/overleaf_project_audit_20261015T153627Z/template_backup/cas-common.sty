\caption{Clique--bridge--leaf motif. The full contact process exports infection only through infected bridge nodes. A prevalence-only macro hazard cannot distinguish infection in ordinary clique nodes from infection in bridge nodes.}
\label{fig:clique_bridge_leaf}
\end{figure}

Let
\begin{equation}
  B_I(t)=\sum_{b\in B}\ind\{X_b(t)=I\}
\end{equation}
be the number of infected bridge nodes. In the full contact network, the exact import intensity into the leaf is
\begin{equation}
  a^{\Full}_{01}(t)=\beta_{\mathrm{out}}B_I(t)\ind\{X_A(t)=S\}.
  \label{eq:bridge_exact_hazard}
\end{equation}
A prevalence-only abstraction with $W_{01}=k$ uses
\begin{equation}
  \lambda^{\Macro}_{01}(t)=\beta_{\mathrm{out}}k\frac{i_0(t)}{n}\ind\{X_A(t)=S\}.
  \label{eq:bridge_macro_hazard}
\end{equation}
If the initial infected node is not a bridge node, then $i_0(0)>0$ and Eq.~\eqref{eq:bridge_macro_hazard} is positive at time zero, whereas Eq.~\eqref{eq:bridge_exact_hazard} remains zero until a bridge node is infected. This is the simplest form of information loss: the macro state knows that infection exists in the source community, but not whether infection has reached the export-relevant part of the network.

For a single bridge node, let
\begin{equation}
  T_B=\inf\{t:B_I(t)>0\}
\end{equation}
be the bridge activation time, and let $T_A$ be the infection time of the leaf. Under SI dynamics with $k=1$,
\begin{equation}
  T_A=T_B+Z,
  \qquad Z\sim\Exp(\beta_{\mathrm{out}}),
\end{equation}
conditionally on the history up to $T_B$, and
\begin{equation}
  \Eop[T_A]=\Eop[T_B]+\frac{1}{\beta_{\mathrm{out}}}.
\end{equation}
If the initial infected node is chosen uniformly from all $n$ clique nodes, including the bridge, then
\begin{equation}
  \Eop[T_B]=\frac{H_{n-1}}{\beta_{\mathrm{in}}n},
  \qquad H_{n-1}=\sum_{m=1}^{n-1}\frac{1}{m}.
\end{equation}
More generally, for $k$ bridge nodes and a uniform all-node initial seed,
\begin{equation}
  \Eop[T_B]
  =\sum_{m=1}^{n-k}
  \frac{\binom{n-k}{m}}{\binom{n}{m}}
  \frac{1}{\beta_{\mathrm{in}}m(n-m)}.
  \label{eq:bridge_activation_general}
\end{equation}
The factor $\binom{n-k}{m}/\binom{n}{m}$ is the probability that the first $m$ infected clique nodes contain no bridge node. As $k$ increases, bridge activation becomes more representative of overall prevalence; as $k$ decreases, interface exposure becomes a more important missing variable.

