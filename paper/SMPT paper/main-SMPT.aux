\newlabel{sec:res_size}{{6.3}{17}{Effects of community size and number of inter-community edges}{subsection.6.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Relationship between discrepancies and the ratio of time scales}{17}{subsection.6.4}\protected@file@percent }
\newlabel{sec:res_descriptor}{{6.4}{17}{Relationship between discrepancies and the ratio of time scales}{subsection.6.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Change in discrepancies along a chain of ten communities with $n=1000$ nodes each. Rows correspond to target ASPL values, and columns to the community reached ($c=1,\ldots  ,9$). Results for $k=1$ are shown above and those for $k=5$ below. Left: relative shift $b_c$ in the median arrival time; negative values mean that \textup  {\textsc  {TwoScale}}{} predicts earlier arrival. Right: normalised Wasserstein distance $e_{W}$. Each configuration uses 400 paired runs. Uncertainty is not shown; results for terminal arrivals are presented in Figure~\ref {fig:accuracy_map}. }}{18}{figure.5}\protected@file@percent }
\newlabel{fig:chain_heatmap}{{5}{18}{Propagation of discrepancies along a chain of communities}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Discrepancies in the terminal arrival time $T_9$ for 48 configurations of ten-community chains. The left panels show the relative median shift $b_9$ (\%), and the right panels show the normalised Wasserstein distance $e_{W}$ (\%). The top row corresponds to $k=1$ and the bottom row to $k=5$. Within each panel, cell rows correspond to target ASPL values and columns to community size $n$. The colour and number in a cell represent the same metric; the colour scales are shared between the two values of $k$ separately for each metric. A negative median shift means earlier arrival in \textup  {\textsc  {TwoScale}}{}. Hatching in the right panels only marks configurations for which the permutation test for the Wasserstein distance did not detect a difference ($p\geq 0.05$). The tests were performed without correction for multiple comparisons. Each configuration uses 400 paired runs. }}{19}{figure.6}\protected@file@percent }
\newlabel{fig:accuracy_map}{{6}{19}{Effects of community size and number of inter-community edges}{figure.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Discussion}{19}{section.7}\protected@file@percent }
\newlabel{sec:discussion}{{7}{19}{Discussion}{section.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Relationship between discrepancies in \textup  {\textsc  {Full}}{} and \textup  {\textsc  {TwoScale}}{} and the time-scale ratio $\rho =\beta _{\mathrm  {out}}\sigma _T$ for 48 chain configurations. (a) Normalised Wasserstein distance $e_{W}$ for the terminal arrival time $T_9$. (b) Relative shift in its median, $b_9$. Colours denote community size; filled circles correspond to $k=1$, and open triangles to $k=5$. Lines connect configurations with ASPL from 1 to 6 at fixed $n$ and $k$. Grey marks in (a) show the 95th percentile of the permutation distribution of the distance for the corresponding configuration. (c) Comparison of relative shifts in the mean duration of the first crossing and crossings 2--9 for $\mathrm  {ASPL}\geq 3$. Error bars show 95\% block-bootstrap intervals for the shift in the first crossing. }}{20}{figure.7}\protected@file@percent }
\newlabel{fig:descriptor}{{7}{20}{Relationship between discrepancies and the ratio of time scales}{figure.7}{}}
