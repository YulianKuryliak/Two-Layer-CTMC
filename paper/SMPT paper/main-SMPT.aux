\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces First export of infection in the clique--leaf network ($n=100$, $k=2$, $\beta =0.005$, 10\,000 runs of each model). (a) Empirical distribution functions of the export time. (b) Distributions of the difference $T_{\mathrm  {export}}-T_B$; negative values correspond to export before either real bridge node becomes infected. (c) Fraction of runs with this violation of the transmission order and 95\% confidence intervals. }}{15}{figure.2}\protected@file@percent }
\newlabel{fig:clique_leaf}{{2}{15}{Temporal accuracy and admissibility of inter-community transmission}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Propagation of discrepancies along a chain of communities}{15}{subsection.6.2}\protected@file@percent }
\newlabel{sec:res_chain_random}{{6.2}{15}{Propagation of discrepancies along a chain of communities}{subsection.6.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effect of the source's internal structure on the first export to the leaf ($n=1000$, $\beta =0.003$, $k=1$ in the top row and $k=5$ in the bottom row; 400 paired runs for each configuration). Left: mean export time. Centre: normalised Wasserstein distance $e_{W}$ between the export-time distributions. Right: fraction of \textup  {\textsc  {TwoScale}}{} exports occurring before infection of the first real bridge; such events are impossible in \textup  {\textsc  {Full}}{}. Error bars show 95\% block-bootstrap intervals. }}{16}{figure.3}\protected@file@percent }
\newlabel{fig:source_sweep}{{3}{16}{Temporal accuracy and admissibility of inter-community transmission}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Infection spread along a chain of ten cliques with 1000 nodes each ($k=1$, $\beta =0.003$, 400 runs of each model). Left: median number of infected nodes over time and interquartile bands, which describe variability among runs rather than confidence intervals. Right: empirical distribution functions of the arrival time at the last community, $T_9$. Four \textup  {\textsc  {Full}}{} values and two \textup  {\textsc  {TwoScale}}{} values lie outside the displayed time range; all are included in the analysis. }}{17}{figure.4}\protected@file@percent }
\newlabel{fig:chain_cliques}{{4}{17}{Propagation of discrepancies along a chain of communities}{figure.4}{}}
