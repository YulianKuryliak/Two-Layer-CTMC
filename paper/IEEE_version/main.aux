\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Effect of the source's internal structure on the first export to the leaf ($n=1000$, $\beta =0.003$, $k=1$ in the top row and $k=5$ in the bottom row; 400 paired runs for each configuration). Left: mean export time. Centre: normalised Wasserstein distance $e_{W}$ between the export-time distributions. Right: fraction of \textup  {TwoScale}{} exports occurring before infection of the first real bridge; such events are impossible in \textup  {Full}{}. Error bars show 95\% block-bootstrap intervals. }}{12}{}\protected@file@percent }
\newlabel{fig:source_sweep}{{3}{12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Infection spread along a chain of ten cliques with 1000 nodes each ($k=1$, $\beta =0.003$, 400 runs of each model). Left: median number of infected nodes over time and interquartile bands, which describe variability among runs rather than confidence intervals. Right: empirical distribution functions of the arrival time at the last community, $T_9$. Four \textup  {Full}{} values and two \textup  {TwoScale}{} values lie outside the displayed time range; all are included in the analysis. }}{12}{}\protected@file@percent }
\newlabel{fig:chain_cliques}{{4}{12}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Change in discrepancies along a chain of ten communities with $n=1000$ nodes each. Rows correspond to target ASPL values, and columns to the community reached ($c=1,\ldots  ,9$). Results for $k=1$ are shown above and those for $k=5$ below. Left: relative shift $b_c$ in the median arrival time; negative values mean that \textup  {TwoScale}{} predicts earlier arrival. Right: normalised Wasserstein distance $e_{W}$. Each configuration uses 400 paired runs. Uncertainty is not shown; results for terminal arrivals are presented in Figure~\ref {fig:accuracy_map}. }}{13}{}\protected@file@percent }
\newlabel{fig:chain_heatmap}{{5}{13}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-C}}Effects of community size and number of inter-community edges}{13}{}\protected@file@percent }
\newlabel{sec:res_size}{{\mbox  {VI-C}}{13}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Discrepancies in the terminal arrival time $T_9$ for 48 configurations of ten-community chains. The left panels show the relative median shift $b_9$ (\%), and the right panels show the normalised Wasserstein distance $e_{W}$ (\%). The top row corresponds to $k=1$ and the bottom row to $k=5$. Within each panel, cell rows correspond to target ASPL values and columns to community size $n$. The colour and number in a cell represent the same metric; the colour scales are shared between the two values of $k$ separately for each metric. A negative median shift means earlier arrival in \textup  {TwoScale}{}. Hatching in the right panels only marks configurations for which the permutation test for the Wasserstein distance did not detect a difference ($p\geq 0.05$). The tests were performed without correction for multiple comparisons. Each configuration uses 400 paired runs. }}{14}{}\protected@file@percent }
\newlabel{fig:accuracy_map}{{6}{14}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-D}}Relationship between discrepancies and the ratio of time scales}{14}{}\protected@file@percent }
\newlabel{sec:res_descriptor}{{\mbox  {VI-D}}{14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Relationship between discrepancies in \textup  {Full}{} and \textup  {TwoScale}{} and the time-scale ratio $\rho =\beta _{\mathrm  {out}}\sigma _T$ for 48 chain configurations. (a) Normalised Wasserstein distance $e_{W}$ for the terminal arrival time $T_9$. (b) Relative shift in its median, $b_9$. Colours denote community size; filled circles correspond to $k=1$, and open triangles to $k=5$. Lines connect configurations with ASPL from 1 to 6 at fixed $n$ and $k$. Grey marks in (a) show the 95th percentile of the permutation distribution of the distance for the corresponding configuration. (c) Comparison of relative shifts in the mean duration of the first crossing and crossings 2--9 for $\mathrm  {ASPL}\geq 3$. Error bars show 95\% block-bootstrap intervals for the shift in the first crossing. }}{15}{}\protected@file@percent }
\newlabel{fig:descriptor}{{7}{15}{}{}{}}
