{
  "network": {
    "communities": 2, // int >= 1
    "community_size": 100, // int >= 1
    "inter_links": 1, // int >= 0
    "seed": 42, // int
    "macro_graph_type": "star", // "complete" | "chain" | "star"
    "micro_graph_type": "clique_leaves", // "complete" | "random" | "random_connected" | "chain" | "clique_leaves"
    "edge_prob": 0.031, // float in [0, 1]
    "leaf_count": 0, // int >= 0 (used when micro_graph_type="clique_leaves")
    "leaf_degree": 1, // int in [0, community_size] (used when micro_graph_type="clique_leaves")
    "star_leaf_attachment": "random" // "random" | "node0" | "random_nonzero" (used when macro_graph_type="star")
  },
  "virus": {
    "beta": 0.005, // float >= 0
    "gamma": 0.0, // float >= 0
    "model": 2 // 1=SIS | 2=SIR
  },
  "simulation": {
    "n_runs": 10000, // int >= 1
    "base_seed": 42, // int
    "T_end": 1000, // float > 0
    "initial_node": 0 // int node id | null - random
  },
  "micro": {
    "dt_out": 1.0, // float > 0
    "out_folder": "data/Simulations_Micro" // relative or absolute path
  },
  "micromacro": {
    "tau_micro": 1.0, // float > 0
    "macro_T": 1.0, // float > 0
    "out_folder": "data/Simulations_MicroMacro", // relative or absolute path
    "print_infection_events": true, // true | false
    "export_infection_events_csv": true, // true | false
    "verbose_steps": false // true | false
  },
  "micromacro_v1": {
    "out_folder": "data/Simulations_MicroMacro_hazard_updated" // relative or absolute path
  }
}
